{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quiz U",
  "version": "1.0.0",
  "identifier": "com.quizu.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": null,
    "frontendDist": "../"
  },
  "app": {
    "windows": [
      {
        "title": "Quiz U",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Interactive team quiz game Quiz U",
    "longDescription": "Interactive team quiz game with offline mode and cross-platform mobile buzzer controls for Steam and Steam Deck."
  }
}
